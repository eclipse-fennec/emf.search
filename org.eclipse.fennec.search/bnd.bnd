Bundle-Name: Eclipse Fennec Search
Bundle-Description: Lucene index units for the Fennec search backend — writer and searcher \
	lifecycle, refresh and commit policy, analyzer registry, EObject-to-document mapping and \
	the QueryProcessor. Plain Java: no OSGi imports, no static state, constructible from an \
	ordinary config object.

-workingset: search

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.search.model;version=snapshot,\
	org.eclipse.fennec.emf.osgi.eobject.registry;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.persistence;version=latest,\
	org.eclipse.fennec.persistence.capabilities;version=latest,\
	org.eclipse.fennec.persistence.query;version=latest,\
	org.eclipse.fennec.query.model;version=latest,\
	org.eclipse.fennec.expression.model;version=latest,\
	org.apache.lucene.core;version=latest,\
	org.apache.lucene.facet;version=latest,\
	org.apache.lucene.highlighter;version=latest,\
	org.apache.lucene.join;version=latest,\
	org.apache.lucene.memory;version=latest,\
	org.apache.lucene.queries;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.annotation.versioning;version=latest

-testpath: \
	assertj-core
