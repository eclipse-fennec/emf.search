Bundle-Name: Eclipse Fennec Search TCK Binding
Bundle-Description: Binds the published persistence TCK to the Lucene backend: one concrete \
	suite over an in-memory index unit per test, gated by the backend's declared capabilities. \
	The suite is plain JUnit — the TCK's own CapabilityGate decides what runs.

-workingset: search

-buildpath: \
	org.osgi.annotation.versioning;version=latest

-testpath: \
	assertj-core,\
	org.eclipse.fennec.persistence.tck;version=latest,\
	org.eclipse.fennec.persistence;version=latest,\
	org.eclipse.fennec.persistence.capabilities;version=latest,\
	org.eclipse.fennec.persistence.query;version=latest,\
	org.eclipse.fennec.persistence.query.derived;version=latest,\
	org.eclipse.fennec.persistence.pushstreams;version=latest,\
	org.eclipse.fennec.expression.ocl;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.parser;version=latest,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.query.model;version=latest,\
	org.eclipse.fennec.expression.model;version=latest,\
	org.eclipse.fennec.command.model;version=latest,\
	org.eclipse.fennec.stream.model;version=latest,\
	org.eclipse.fennec.search;version=snapshot,\
	org.eclipse.fennec.search.model;version=snapshot,\
	org.eclipse.fennec.emf.osgi.eobject.registry;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.apache.lucene.core;version=latest,\
	org.apache.lucene.facet;version=latest,\
	org.apache.lucene.join;version=latest,\
	org.osgi.util.pushstream;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest
