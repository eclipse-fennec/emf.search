-resourceonly: true
-include: ${.}/buildpath.bnd
mavendeps: ${sjoin;\n; ${template;-maven-dependencies;${@}}}

-includeresource: {resources}

Provide-Capability: \
	${fennec-base}

fennec-base:\
    bnd.library;\
        bnd.library     = fennecSearch; \
        path            = template
Bundle-Name: Eclipse Fennec Search
Bundle-Description: Eclipse Fennec Search Dependencies
