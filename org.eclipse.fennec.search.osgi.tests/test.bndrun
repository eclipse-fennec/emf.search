-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.search.osgi.tests',\
	bnd.identity;id='org.eclipse.fennec.search.osgi',\
	bnd.identity;id='org.apache.felix.configadmin'

-runbundles.test: \
	org.eclipse.fennec.search.osgi.tests;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21

# Resolved closure, for launching this bndrun from bndtools. NOT what `testOSGi` runs:
# `build.gradle` redirects the resolve output to `generated/test.bndrun` and launches that,
# so this list is a convenience copy and has to be refreshed by hand after a resolve
# (`./gradlew :org.eclipse.fennec.search.osgi.tests:resolve.test --rerun`, then copy from
# `generated/test.bndrun`). It went stale once already — see #35.
-runbundles: \
	assertj-core;version='[3.27.7,3.27.8)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	net.bytebuddy.byte-buddy;version='[1.18.4,1.18.5)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.apache.lucene.core;version='[10.5.0,10.5.1)',\
	org.apache.lucene.facet;version='[10.5.0,10.5.1)',\
	org.apache.lucene.highlighter;version='[10.5.0,10.5.1)',\
	org.apache.lucene.join;version='[10.5.0,10.5.1)',\
	org.apache.lucene.memory;version='[10.5.0,10.5.1)',\
	org.apache.lucene.queries;version='[10.5.0,10.5.1)',\
	org.apache.lucene.suggest;version='[10.5.0,10.5.1)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.command.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.eobject.registry;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.metadata;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.expression.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.capabilities;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.query;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.query.model;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.search;version=snapshot,\
	org.eclipse.fennec.search.model;version=snapshot,\
	org.eclipse.fennec.search.osgi;version=snapshot,\
	org.eclipse.fennec.search.osgi.tests;version=snapshot,\
	org.eclipse.fennec.search.suggest;version=snapshot,\
	org.eclipse.fennec.stream.model;version='[0.1.0,0.1.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)'
